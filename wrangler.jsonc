{
  // The name of your Worker.
  "name": "dink-url-manager",
  // The entry point to your Worker.
  "main": "src/worker.tsx",
  // The date your Worker was last published, used to determine compatibility.
  "compatibility_date": "2026-05-02",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": true,
  "workers_dev": true,

  "vars": {
    // Set to true to prevent the creation of new webhook configurations.
    "DISABLE_NEW_CONFIGS": false
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dink-url-manager",
      "migrations_dir": "./migrations"
    }
  ],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  "ratelimits": [
    {
      "name": "CONFIG_CREATE_RATELIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 2, "period": 10 }
    },
    {
      "name": "CONFIG_UPDATE_RATELIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 10 }
    },
    {
      "name": "WEBHOOK_SECRET_RATELIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 100, "period": 10 }
    },
    {
      "name": "WEBHOOK_IP_RATELIMIT",
      "namespace_id": "1004",
      "simple": { "limit": 250, "period": 10 }
    }
  ]
}
